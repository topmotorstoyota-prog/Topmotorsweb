generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  name              String?
  role              String   @default("EDITOR")
  canManageVehicles  Boolean  @default(false)
  canManageNews      Boolean  @default(false)
  canManageWheelsTires Boolean @default(false) // Дугуй, Обуд
  canManageMerch     Boolean  @default(false) // GR Merch
  canManageToyotaQ   Boolean  @default(false)
  canManageSalesBookings   Boolean @default(false) // Шинэ машин захиалга, Тест драйв, Зурвас
  canManageServiceBookings Boolean @default(false) // Засварын хүсэлт
  canManageHomeBanner Boolean @default(false)
  canManageStaff     Boolean  @default(false) // Борлуулалтын ажилчид
  canManageShipment  Boolean  @default(false) // Тээвэрлэлт хянах
  createdAt         DateTime @default(now())
}

model Vehicle {
  id          String   @id
  name        String
  nameEn      String?  // Англи нэр
  category    String
  isFeatured  Boolean  @default(false)
  testDriveEnabled Boolean @default(false) // Тест драйвын жагсаалтад харагдах эсэх
  image       String   // Үндсэн зураг
  images      String?  // Цомгийн зургууд (Gallery) - JSON string
  images360   String?  // 360 эргэлттэй зургууд (16 ширхэг) - JSON string
  description String
  descriptionEn String? // Англи тайлбар
  price       String?
  colors      String?  // Өнгөнүүд (нэр, код, зураг) - JSON string
  variants    String?  // Хувилбарууд (мотор, тоноглол, үнэ, зураг, үзүүлэлт) - JSON string (спек талбар бүр *_en хос талтай)
  features    String?  // Үзүүлэлтүүд (Interior, Exterior, Safety...) - JSON string
  updatedAt   DateTime @updatedAt
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  titleEn   String?
  content   String
  contentEn String?
  excerpt   String?
  excerptEn String?
  image     String?
  date      String?
}

// Бүтээгдэхүүн (Lifestyle Products/Accessories)
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  nameEn      String?
  category    String
  price       String?
  size        String?  // Хэмжээ (жишээ нь: 265/65R17)
  image       String?
  images      String?  // Цомгийн зургууд - JSON string
  description String?
  descriptionEn String?
  stock       String?  @default("Бэлэн байгаа")
  quantity    Int      @default(0)
  variants    String?  // Дугуй: хэмжээ тус бүрийн үнэ - JSON string [{size, price}]
  purpose     String?  // Дугуй: зориулалт (Зун, Өвөл, Бүх улирал)
}

// Захиалгын тээвэрлэлт хянах - admin-аас Excel файлаар upload хийж бөглөнө
model ShipmentVehicle {
  id             Int      @id @default(autoincrement())
  vin            String   @unique
  vinLast5       String   // хайлтад ашиглана (VIN-ий сүүлийн 5 орон)
  ocsNumber      String?  // жишээ: TMON2606
  manufactureYearMonth String? // OCS number-ий сүүлийн 4 оронгоос гаргасан "2026-06"
  shipmentNumber String?  // жишээ: VH-TM0364
  modelName      String?  // жишээ: LC300, LC300HEV
  exteriorColor  String?
  interiorColor  String?
  status         String?  // Excel-ийн түүхий status текст, жишээ: "1_UB station 9/1"
  updatedAt      DateTime @updatedAt
}

model ToyotaQ {
  id          Int      @id @default(autoincrement())
  name        String
  nameEn      String?
  price       String?
  image       String?
  images      String?
  year        String?
  mileage     String?
  engine      String?
  engineType  String?
  description String?
  descriptionEn String?
  serviceHistory String? // Засварын түүх PDF URL
  updatedAt   DateTime @updatedAt
}

model Booking {
  id          Int      @id @default(autoincrement())
  type        String   // test_drive, service, or message
  serviceType String?  // Сонгосон үйлчилгээний төрөл
  vehicle     String?
  plate       String?
  date        String
  time        String
  name        String
  phone       String
  email       String?
  description String?  // Зурвасын агуулга хадгалах
  status      String   @default("Шинэ") // Шинэ, Баталгаажсан, Цуцлагдсан
  contacted   Boolean  @default(false) // Админ холбогдсон эсэх
  contactedBy String?  // Холбогдсон гэж тэмдэглэсэн админы нэр
  createdAt   DateTime @default(now())
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  phone     String
  image     String?
  order     Int      @default(0)
}

model HomeBanner {
  id        Int      @id @default(autoincrement())
  image     String
  updatedAt DateTime @updatedAt
}

// Админ хэрэглэгчдийн үйл ажиллагааны түүх (SUPER_ADMIN-д зориулав)
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  userName   String
  userEmail  String
  action     String   // CREATE, UPDATE, DELETE
  entity     String   // vehicles, news, products, toyota-q, staff, home-banner, bookings, users
  entityId   String
  entityName String?
  createdAt  DateTime @default(now())
}
