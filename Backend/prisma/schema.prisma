generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  password          String
  name              String?
  role              String   @default("EDITOR")
  canManageVehicles  Boolean  @default(false)
  canManageNews      Boolean  @default(false)
  canManageWheelsTires Boolean @default(false) // Дугуй, Обуд
  canManageMerch     Boolean  @default(false) // GR Merch
  canManageToyotaQ   Boolean  @default(false)
  canManageBookings  Boolean  @default(false)
  canManageHomeBanner Boolean @default(false)
  createdAt         DateTime @default(now())
}

model Vehicle {
  id          String   @id
  name        String
  category    String
  isFeatured  Boolean  @default(false)
  image       String   // Үндсэн зураг
  images      String?  // Цомгийн зургууд (Gallery) - JSON string
  images360   String?  // 360 эргэлттэй зургууд (16 ширхэг) - JSON string
  description String
  price       String?
  colors      String?  // Өнгөнүүд (нэр, код, зураг) - JSON string
  variants    String?  // Хувилбарууд (мотор, тоноглол, үнэ, зураг, үзүүлэлт) - JSON string
  features    String?  // Үзүүлэлтүүд (Interior, Exterior, Safety...) - JSON string
  updatedAt   DateTime @updatedAt
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  excerpt   String?
  image     String?
  date      String?
}

// Бүтээгдэхүүн (Lifestyle Products/Accessories)
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  price       String?
  size        String?  // Хэмжээ (жишээ нь: 265/65R17)
  image       String?
  images      String?  // Цомгийн зургууд - JSON string
  description String?
  stock       String?  @default("Бэлэн байгаа")
  quantity    Int      @default(0)
}

model ToyotaQ {
  id          Int      @id @default(autoincrement())
  name        String
  price       String?
  image       String?
  images      String?
  year        String?
  mileage     String?
  engine      String?
  engineType  String?
  description String?
  serviceHistory String? // Засварын түүх PDF URL
  updatedAt   DateTime @updatedAt
}

model Booking {
  id          Int      @id @default(autoincrement())
  type        String   // test_drive, service, or message
  serviceType String?  // Сонгосон үйлчилгээний төрөл
  vehicle     String?
  plate       String?
  date        String
  time        String
  name        String
  phone       String
  email       String?
  description String?  // Зурвасын агуулга хадгалах
  status      String   @default("Шинэ") // Шинэ, Баталгаажсан, Цуцлагдсан
  createdAt   DateTime @default(now())
}

model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  phone     String
  image     String?
  order     Int      @default(0)
}

model HomeBanner {
  id        Int      @id @default(autoincrement())
  image     String
  updatedAt DateTime @updatedAt
}
